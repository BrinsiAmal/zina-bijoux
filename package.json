{
  "name": "zina-bijoux",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boutique en ligne de faux bijoux : React (Vite) + Node.js (Express)",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "test": "node --test server/app.test.js"
  },
  "dependencies": { "express": "^4.21.2" },
  "devDependencies": { "concurrently": "^9.1.0" }
}
